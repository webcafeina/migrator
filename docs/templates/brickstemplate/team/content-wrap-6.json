        "_direction": "row",
        "_alignItems": "center",
        "_columnGap": "10px",
        "_cssCustom": ".bt-team3 {\n    position: relative;\n    overflow: hidden;\n}\n.bt-img3 {\n    transition: all 0.5s;\n}\n.bt-team3:hover .bt-img3 {\n    transform: translateY(80px);\n}\n.bt-name3 {\n    position: absolute;\n    top: 0;\n    left: 0;\n}\n.bt-social3 {\n    opacity: 1;\n    transform: translateX(50px);\n    transition: all 0.5s;\n}\n\n.bt-team3:hover .bt-social3 {\n    opacity: 1;\n    transform: translateX(0px);\n}\n",
        "_cssCustom:tablet_portrait": ".bt-team3:hover .bt-img3 {\n    transform: translateY(80px);\n}",
        "_justifyContent:mobile_landscape": "center",
        "_cssCustom:mobile_portrait": ".bt-team3:hover .bt-img3 {\n    transform: translateY(90px);\n}"
      }
