        "user_id": 2,
        "time": 1712524113,
        "noRoot": true,
        "_cssGlobalClasses": [
          "iuaavm"
        ],
        "javascriptCode": "\n\ndocument.addEventListener('DOMContentLoaded', (event) => {\n  // Define a function to update the no-drag option for all splide instances on the page\n  const updateNoDragOption = () => {\n    for( const splideId in window.bricksData.splideInstances ) {\n      const splideInstance = window.bricksData.splideInstances['vkwyfe'] //Change this with your slider element ID, only add the second half. for example \"#brxe-vkwyfe\" you need to add only \"vkwyfe\"\n      if ( splideInstance ) {\n          splideInstance.destroy();\n         splideInstance.mount( window.splide.Extensions );\n         splideInstance.options = { autoScroll: {\n    speed: 2, // Adjust auto scroll speed here\n  }, }\n\t\tsplideInstance.options = { direction: 'ltr', } // Change slider direction to ltr left-to-right, rtl right-to-lef\n      }\n    }\n  }\n  \n  // Need some delay for Bricks to init the sliders\n  setTimeout(updateNoDragOption, 250)\n})\n"
      },
      "themeStyles": {}
    }
  ],
