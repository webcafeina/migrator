        "_cssCustom": ".migrator-product-categories-14__term-wrap .splide__arrow {\n    box-shadow: 0 2px 8px 0 rgba(99, 99, 99, 0.2);\n    opacity: 0;\n  transition: all .3s;\n}\n.migrator-product-categories-14__term-wrap .splide__arrow--prev {\n    left: -45px;\n  transition: all .3s;\n}\n.migrator-product-categories-14__term-wrap .splide__arrow--next {\n    right: -45px;\n  transition: all .3s;\n}\n:root div.migrator-product-categories-14__term-wrap:hover .splide__arrow {  \n  \topacity: 1;  \n}\n:root div.migrator-product-categories-14__term-wrap:hover .splide__arrow--prev {\n    left: -15px;\n}\n:root div.migrator-product-categories-14__term-wrap:hover .splide__arrow--next {\n    right: -15px;\n}"
