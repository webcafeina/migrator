        "_cssCustom": ".custom_slider_06 .splide__arrow {\n    position: absolute;\n    bottom: -30px;\n  \ttop: auto;\n    left: auto;\n  \tpadding: 15px;\n  opacity: 0;\n}\n.custom_slider_06 .splide__arrow svg {\n  fill: #fff;\n}\n.custom_slider_06:hover .splide__arrow {\n    opacity: 1;\n}\n\n.custom_slider_06 .splide__arrow--prev {\n    right: 100px;\n}\n.custom_slider_06 .splide__arrow--next {\n    right: 0px;\n}\n\n.slider_content {\n  opacity: 0;\n  transform: translateY(100px);\n  transition: transform 0.3s ease, opacity 0.3s ease;\n}\n\n.custom_slider_06:hover .slider_content {\n  transform: translateY(0);\n  opacity: 1;\n}\n.slidebg {\n  position: relative;\n}\n\n.slidebg::before {\n  content: '';\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  background-image: linear-gradient(to bottom right, #8467d9, #34c174);\n  opacity: 0;\n  transition: background-image 0.3s ease, opacity 0.3s ease;\n}\n\n\n.slidebg:hover::before {\n  background-color: rgba(0, 0, 0, 0.5); /* Overlay color on hover */\n  opacity: 0.7;\n}\n\n\n"
