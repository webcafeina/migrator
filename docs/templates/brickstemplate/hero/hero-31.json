        "signature": "d01dd2d157c2ed9ac1bf50e88cf9a198",
        "user_id": 2,
        "time": 1712525772,
        "noRoot": true,
        "javascriptCode": "\n\n  document.addEventListener('DOMContentLoaded', (event) => {\n    // Define a function to update the no-drag option for all splide instances on the page\n    const updateNoDragOption = () => {\n      for( const splideId in window.bricksData.splideInstances ) {\n        const splideInstance = window.bricksData.splideInstances['tqizrt']; //Change this with your slider element ID, only add the second half. for example \"#brxe-vkwyfe\" you need to add only \"vkwyfe\"\n        if ( splideInstance ) {\n          splideInstance.destroy();\n          splideInstance.mount( window.splide.Extensions );\n          splideInstance.options = {\n            autoScroll: {\n              speed: 1, // Adjust auto scroll speed here\n            },\n            direction: 'ltr', // Change slider direction to ltr left-to-right, rtl right-to-left\n          };\n        }\n      }\n    }\n    \n    // Need some delay for Bricks to init the sliders\n    setTimeout(updateNoDragOption, 250);\n  });\n\n  function blurOthers(element) {\n    var siblings = Array.from(element.parentElement.children);\n    siblings.forEach(function(sibling) {\n      if (sibling !== element) {\n        sibling.style.filter = \"blur(3px)\"; // Adjust blur strength here\n      } else {\n        sibling.style.filter = \"none\";\n      }\n    });\n  }\n\n  function resetStyles() {\n    var elements = document.querySelectorAll('.child-element');\n    elements.forEach(function(element) {\n      element.style.filter = \"none\";\n    });\n  }\n\n",
        "_cssGlobalClasses": [
          "xihiuc"
