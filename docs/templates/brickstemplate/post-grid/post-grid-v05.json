          "right": "2rem"
        }
      }
    },
    {
      "id": "paqypl",
      "name": "migrator-post-grid-v05__container",
      "settings": {
        "_display": "grid",
        "_gridGap": "1rem",
        "_gridAutoRows": "25rem",
        "_gridTemplateColumns:mobile_portrait": "1fr",
        "_gridAutoRows:mobile_portrait": "30rem",
        "_gridTemplateColumns": "1fr 0.5fr 1fr",
        "_gridTemplateColumns:mobile_landscape": "1fr",
        "_gridAutoRows:mobile_landscape": "30rem"
      }
    },
    {
      "id": "zqqkaj",
