# =============================================================
# Webcafeína Migrator — variables de entorno
# Copia este fichero a `.env` y rellena los valores reales.
# NUNCA commitees `.env`. Solo `.env.example` está versionado.
# =============================================================

# ---------- Entorno general ----------
ENV=development                          # development | staging | production
APP_NAME=webcafeina-migrator
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
LOG_LEVEL=info                           # debug | info | warning | error
SECRET_KEY=changeme-generate-with-openssl-rand-hex-32

# ---------- Base de datos ----------
DATABASE_URL=postgresql+asyncpg://webcafeina:changeme@localhost:5432/webcafeina_migrator
DATABASE_SYNC_URL=postgresql://webcafeina:changeme@localhost:5432/webcafeina_migrator
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ---------- Redis / Celery ----------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_DEFAULT_QUEUE=webcafeina

# ---------- Auth (dashboard) ----------
JWT_SECRET=changeme-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480
SESSION_COOKIE_NAME=wcm_session

# ---------- Scraping / Anti-detección ----------
# Estrategia layered (ADR-017). Configura los backends según tier disponible;
# build_default_rotator elige el primero según prioridad.
#
# Tier 1 — Webshare free (10 datacenter IPs + 1GB/mes, sin tarjeta):
#   crear cuenta en webshare.io → Proxy Settings → Default Username/Password
WEBSHARE_USER=
WEBSHARE_PASSWORD=
#
# Tier 2 — ScraperAPI free (5k calls/mes con rotación + captcha):
#   crear cuenta en scraperapi.com → copiar API key
SCRAPERAPI_KEY=
#
# Tier 3 — Bright Data residencial (premium, pay-as-you-go):
BRIGHTDATA_CUSTOMER_ID=
BRIGHTDATA_ZONE=
BRIGHTDATA_PASSWORD=
BRIGHTDATA_PROXY_HOST=brd.superproxy.io
BRIGHTDATA_PROXY_PORT=22225

# Configuración general del scraper
PLAYWRIGHT_HEADLESS=true
SCRAPER_DEFAULT_TIMEOUT_MS=30000
SCRAPER_MIN_DELAY_MS=3000
SCRAPER_MAX_DELAY_MS=8000
RESPECT_ROBOTS_TXT=true                  # solo en prospección. En migración (con consentimiento) se ignora.

# ---------- Captcha ----------
TWOCAPTCHA_API_KEY=

# ---------- Embeddings (leads.embedding) ----------
# sentence-transformers local con `intfloat/multilingual-e5-large` (1024 dim).
# ADR-023 supersede ADR-010 (Voyage AI). Modelo se descarga primera vez
# (~2.2GB) a ~/.cache/huggingface/. EMBEDDING_DEVICE=cuda si hay GPU.
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DEVICE=cpu
VOYAGE_API_KEY=                          # deprecado (mantener para compat)

# ---------- Google Maps Places ----------
GOOGLE_MAPS_API_KEY=
# Endpoint base + región/idioma de la API Places. Override para tests
# (mock server) o para targetear otro mercado regional.
GOOGLE_MAPS_API_BASE=https://maps.googleapis.com/maps/api/place
GOOGLE_MAPS_LANGUAGE=es
GOOGLE_MAPS_REGION=es

# ---------- WordPress destino (default sandbox) ----------
WP_DEFAULT_HOST=
WP_DEFAULT_SITE_URL=                          # https://test-migrator.tudominio.com
WP_DEFAULT_SSH_USER=
WP_DEFAULT_SSH_PORT=22
WP_DEFAULT_SSH_KEY_PATH=~/.ssh/id_ed25519
WP_DEFAULT_WPCLI_PATH=/usr/local/bin/wp
WP_DEFAULT_REST_USER=
WP_DEFAULT_REST_APP_PASSWORD=
# Ruta absoluta del docroot WP en el servidor (necesaria para wp-cli
# en hostings sin --path autodetect).
WP_PATH=/home/USER/public_html
# Si true verifica el certificado SSL del destino. false útil en
# staging con auto-firmados.
WP_VERIFY_SSL=true

# ---------- Bricks Builder ----------
BRICKS_LICENSE_KEY=

# ---------- ClickUp ----------
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=20483773
CLICKUP_DEFAULT_LIST_ID=900102088242     # Microtareas
# Assignee ClickUp por defecto para residual_tasks (entero ClickUp user_id).
# Vacío = no asignar a nadie en concreto (ClickUp lo deja "unassigned").
CLICKUP_DEFAULT_ASSIGNEE=

# ---------- Resend (email transaccional) ----------
RESEND_API_KEY=
RESEND_FROM_EMAIL=migrator@webcafeina.com
RESEND_NOTIFY_OPERATIONS=info@webcafeina.com
# Para verificar eventos entrantes (opens/bounces/replies). Se genera en
# Resend Dashboard → Webhooks → Signing Secret.
RESEND_WEBHOOK_SECRET=

# ---------- Sentry ----------
SENTRY_DSN_API=
SENTRY_DSN_WORKER=
SENTRY_DSN_DASHBOARD=
# v0.22.0+ — Variante pública (Next.js client bundle). Debe ser idéntica
# a SENTRY_DSN_DASHBOARD en condiciones normales. Si está vacía, el
# dashboard no envía errores client-side.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.2

# ---------- Claude Vision (v0.22.0+, sprint AI assist — DESACTIVADO v0.23.1) ----------
# Anthropic API key. Mantiene el código intacto por si se reactiva en
# tier pagado. Pipeline canónico NO usa Claude desde v0.23.1.
ANTHROPIC_API_KEY=
# Cap absoluto de bloques que se envían a Claude por proyecto.
WCM_AI_MAX_BLOCKS_PER_PROJECT=30

# ---------- OpenAI (v0.25.0+, pivote arquitectónico rediseño) ----------
# API key OpenAI usada por:
# - BriefGeneratorAgent (gpt-4o-mini ~$0.01/proyecto) para inferir
#   business_description, sector, tone_of_voice, target_audience, usps.
# - RedesignAIAgent (gpt-4o ~$0.30-1.50/página) para generar el JSON
#   Bricks de cada página a partir del Brief.
# Sin esta key, el pipeline `design_method=ai` falla preflight.
# `design_method=templates` no requiere OpenAI.
OPENAI_API_KEY=
# Modelos. Override para usar gpt-4-turbo o gpt-3.5-turbo si se desea
# reducir coste a cambio de calidad menor.
OPENAI_MODEL_METADATA=gpt-4o-mini
OPENAI_MODEL_REDESIGN=gpt-4o

# ---------- Logtail ----------
LOGTAIL_SOURCE_TOKEN=

# ---------- Cloudflare R2 (assets) ----------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=webcafeina-migrator-assets
R2_PUBLIC_URL_BASE=

# ---------- Outreach (revisión humana, no envío automático) ----------
OUTREACH_REVIEW_REQUIRED=true
OUTREACH_OPT_OUT_URL_BASE=https://webcafeina.com/opt-out

# ---------- Empresa (para cumplimiento legal en outreach) ----------
COMPANY_LEGAL_NAME=Webcafeína S.L.
COMPANY_CIF=                              # rellenar
COMPANY_ADDRESS=                          # rellenar
COMPANY_CONTACT_EMAIL=info@webcafeina.com
COMPANY_PRIVACY_POLICY_URL=https://webcafeina.com/politica-de-privacidad

# ---------- Email branding (v0.14.0) ----------
# URL pública del logo Webcafeína embebido en el header de los correos
# HTML de outreach. Generada por `python scripts/upload_email_logo.py`
# tras dejar el PNG en `apps/api/assets/webcafeina-email-logo.png`.
# Si está vacío, el layout pinta "webcafeína" como texto estilado.
EMAIL_LOGO_URL=

# ---------- Visual diff ----------
VISUAL_DIFF_THRESHOLD=0.85
# v0.20.0+ (ADR-044) — Threshold (0-1) bajo el cual visual_diff genera
# ResidualTask VISUAL_CONTENT por página. Override por proyecto vía
# projects.visual_diff_threshold (UI → Configuración avanzada).
VISUAL_DIFF_RESIDUAL_THRESHOLD=0.70

# ---------- QA umbrales (ADR-053, v0.20.0+) ----------
# Lighthouse: scores 0-100 bajo los cuales qa_runner crea ResidualTask
# POST_GO_LIVE. Ajustar globalmente sin redeploy editando estas vars.
# Performance: WCAG / Core Web Vitals categoriza poor < 50.
LIGHTHOUSE_PERF_MIN_CRITICAL=50
# Accesibilidad: WCAG 2.1 AA exige ≥90 para sitios públicos UE.
# Bajo 70 = problemas estructurales graves (sin alt, contraste, teclado).
LIGHTHOUSE_A11Y_MIN_CRITICAL=70
# Best practices: bajo 75 = mixed content, vulnerabilidades JS, console errors.
LIGHTHOUSE_BEST_PRACTICES_MIN_CRITICAL=75
# SEO técnico: bajo 80 = titles/descriptions faltantes, robots mal, etc.
LIGHTHOUSE_SEO_MIN_CRITICAL=80
# HTML W3C: errores totales sobre la página antes de crear residual.
HTML_ERRORS_MAX_CRITICAL=20
# Broken links: fórmula proporcional max(MIN_ABSOLUTE, total * RATIO).
# En web pequeña (10 links) → threshold=2; en grande (500) → threshold=15.
BROKEN_LINKS_MIN_ABSOLUTE=2
BROKEN_LINKS_RATIO_THRESHOLD=0.03

# ---------- Scraper origin (ADR-050, v0.20.0+) ----------
# Cap de páginas a scrapear por defecto. Override por proyecto vía
# projects.max_pages_scrape (UI → Configuración avanzada). Rango 1-500.
SCRAPE_MAX_PAGES_DEFAULT=50

# ---------- Pre-deploy snapshot SQL (ADR-042, v0.20.1) ----------
# Directorio remoto donde el agent guarda los `wp db export`. Por defecto
# `~/wcm-snapshots` que se resuelve al $HOME del usuario SSH (compatible
# con WHM/cPanel sin root). Override a un path absoluto si tienes un dir
# dedicado con permisos (p.ej. /var/backups/wcm-snapshots montado para
# el usuario SSH). Crear con `mkdir -p` se hace siempre antes del export.
WCM_REMOTE_SNAPSHOT_DIR=~/wcm-snapshots

# ---------- woo_orders RGPD (ADR-045, v0.20.0+) ----------
# Días de retención de la tabla woo_orders (historial pedidos con PII).
# Celery beat ejecuta purge diario tras este TTL desde migrated_at.
WOO_ORDERS_RETENTION_DAYS=30

# ---------- Cifrado credenciales sensibles (v0.18.0) ----------
# Clave Fernet única para deploy_credentials_encrypted (destino WP) y
# source_credentials_encrypted (back del origen Wix/Webflow). API + worker
# deben compartir EXACTAMENTE la misma clave. Si se rota, hay que
# re-introducir todas las credenciales guardadas.
# Generar nueva: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
FERNET_KEY=
