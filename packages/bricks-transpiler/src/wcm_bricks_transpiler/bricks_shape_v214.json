{
  "_meta": {
    "version": "2.1.4",
    "source": "docs/referencias/h2b-skill/h2b/references/ + docs/referencias/bricks-skills/",
    "generated_at": "2026-06-01",
    "purpose": "Shape canónico de elementos Bricks Builder consumido por (a) BricksAdapter determinista para convertir LLM semantic output → native Bricks JSON, (b) validator estricto de settings shape, (c) prompt LLM con ejemplos verbatim.",
    "common_required_keys": ["id", "name", "parent", "children", "settings"]
  },
  "_conventions": {
    "color_format": {
      "options": [
        {"shape": {"hex": "#000000"}, "use": "color literal"},
        {"shape": {"raw": "var(--bricks-color-xxx)"}, "use": "CSS variable global"}
      ],
      "rejected": [
        "{global: {id: '...'}} no existe en Bricks 2.1.4",
        "string plana '#000' no se acepta — debe ser objeto"
      ]
    },
    "spacing_format": {
      "shape": {"top": "value", "right": "value", "bottom": "value", "left": "value"},
      "units": ["rem", "px", "%", "em", "vh", "vw"],
      "note": "Objeto verbatim — NO arrays, NO shorthand string"
    },
    "global_classes": {
      "key": "_cssGlobalClasses",
      "shape": ["classId1", "classId2"],
      "note": "Array de strings IDs — NO objeto con id+name"
    },
    "typography_keys_case": {
      "rule": "snake-case CON GUION (kebab-case)",
      "valid_examples": ["font-family", "font-size", "font-weight", "line-height", "letter-spacing", "text-align", "text-transform", "text-decoration"],
      "invalid_examples": ["font_size (underscore)", "fontSize (camel)", "fontFamily (camel)"],
      "wrapper": "_typography",
      "critical": "Este es el bug raíz del E2E v0.27.0 — gpt-5-mini producía font_size con underscore y Bricks lo ignoraba silenciosamente"
    },
    "responsive_suffixes": {
      "syntax": "<setting_key>:<breakpoint>",
      "breakpoints": ["laptop", "tablet_landscape", "tablet_portrait", "mobile_landscape", "mobile_portrait"],
      "example": {"perPage:tablet_portrait": "2", "perPage:mobile_portrait": "1"}
    },
    "background_image_vs_image_element": {
      "warning": "Shapes DISTINTOS",
      "background_image": {"keys": ["url", "size", "position", "repeat"], "note": "sin id, sin filename"},
      "image_element": {"keys": ["id", "url", "external", "filename", "size", "full"], "note": "id requerido si viene de WP media library"}
    }
  },
